{
  "name": "datatables.net-AltEditor",
  "version": "4.0.1",
  "description": "Dialog CRUD and cell inline editing for DataTables 2.x",
  "author": {
    "name": "KasperOlesen",
    "url": "https://github.com/KasperOlesen/DataTable-AltEditor"
  },
  "homepage": "https://bensitu.github.io/DataTable-AltEditor/",
  "bugs": {
    "url": "https://github.com/bensitu/DataTable-AltEditor/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bensitu/DataTable-AltEditor.git"
  },
  "keywords": [
    "DataTables",
    "Editor",
    "Free",
    "crud",
    "inline-editing"
  ],
  "license": "MIT",
  "main": "dist/dataTables.altEditor.js",
  "contributors": [
    {
      "name": "KasperOlesen"
    },
    {
      "name": "luca-vercelli"
    },
    {
      "name": "zack-hable"
    },
    {
      "name": "zadarkside"
    },
    {
      "name": "bensitu"
    }
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "CODE_OF_CONDUCT.md",
    "docs",
    "translations"
  ],
  "unpkg": "dist/dataTables.altEditor.min.js",
  "jsdelivr": "dist/dataTables.altEditor.min.js",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "peerDependencies": {
    "datatables.net": ">=2.1.0 <3",
    "jquery": ">=1.8 <5"
  },
  "scripts": {
    "build": "rollup -c",
    "build:pages": "npm run build && node scripts/build-pages.mjs",
    "dev": "http-server . -p 8080 -c-1",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test --project=chromium --grep-invert compatibility",
    "test:compat": "node scripts/compatibility.mjs",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@rollup/plugin-terser": "1.0.0",
    "@vitest/coverage-v8": "5.0.0",
    "bootstrap": "5.3.8",
    "bootstrap4": "npm:bootstrap@4.6.2",
    "clean-css": "5.3.3",
    "datatables.net": "2.3.8",
    "datatables.net-buttons": "3.2.6",
    "datatables.net-select": "3.1.3",
    "datatables21": "npm:datatables.net@2.1.8",
    "eslint": "10.10.0",
    "foundation-sites": "6.9.0",
    "http-server": "14.1.1",
    "jquery": "3.7.1",
    "jsdom": "30.0.1",
    "prettier": "3.9.6",
    "rollup": "4.63.1",
    "vitest": "5.0.0"
  }
}
